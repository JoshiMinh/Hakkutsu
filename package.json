{
  "name": "hakkutsu",
  "displayName": "Hakkutsu — Japanese Immersion",
  "version": "2.7.1",
  "description": "Local-first open-source Japanese immersion extension with offline dictionary, Japanese parsing, SRS, and dual subtitles.",
  "author": "Hakkutsu Team",
  "private": true,
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:browser": "vite --config tests/vite.config.ts",
    "dev": "wxt",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.27.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "@wxt-dev/module-react": "^1.2.2",
    "prettier": "3.2.4",
    "typescript": "5.3.3",
    "vite": "^5.4.14",
    "wxt": "^0.19.29"
  }
}
