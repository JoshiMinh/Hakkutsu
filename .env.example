# Sao chép file này thành .env rồi điền khóa. Không commit file .env.
TRANSLATION_API_URL=https://api.deepseek.com/chat/completions
TRANSLATION_MODEL=deepseek-v4-flash
TRANSLATION_API_KEY=
TRANSLATION_TIMEOUT=120
# Model nhỏ Hakkutsu sau khi fine-tune. Giữ false đến khi evaluation đạt.
JAVI_ANALYSIS_ENABLED=false
JAVI_ANALYSIS_API_URL=http://127.0.0.1:11434/v1/chat/completions
JAVI_ANALYSIS_MODEL=hakkutsu-javi:latest
JAVI_ANALYSIS_API_KEY=
JAVI_ANALYSIS_TIMEOUT=45
SHOW_MODE_SWITCH=true
LAMA_ENABLED=true
# LAMA_MODEL_PATH=data/models/lama/big-lama.pt
CTD_ENABLED=true
CTD_DEVICE=auto
# SFX lớn/dọc được quét ở nhiều scale để tránh mất chữ đầu hoặc cuối.
CTD_MULTI_SCALES=1024,704,576
VISUAL_SUPERVISOR_ENABLED=false
VISUAL_SUPERVISOR_API_URL=http://127.0.0.1:11434/v1/chat/completions
VISUAL_SUPERVISOR_MODEL=qwen3.5:9b
VISUAL_SUPERVISOR_TIMEOUT=180
VISUAL_SUPERVISOR_MAX_EDGE=1600
VISUAL_SUPERVISOR_MIN_CONFIDENCE=0.62
# CTD_MODEL_PATH=data/models/comic-text-detector/comictextdetector.pt
# CTD_VENDOR_PATH=data/vendor/comic-text-detector

# OCR_DETECTOR=comic
# OCR_DETECTION_THRESHOLD=0.35
# OCR_RECOGNIZER=manga_ocr
# Giữ CPU để kết quả ổn định; chỉ đổi sang cuda sau khi A/B test.
OCR_GPU=cpu
BUBBLE_DEVICE=cpu
