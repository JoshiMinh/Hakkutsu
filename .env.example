# Copy this file to .env and fill in the keys. Do not commit the .env file.

# Core Translation API (Required)
TRANSLATION_API_KEY=
# TRANSLATION_API_URL=https://api.deepseek.com/chat/completions
# TRANSLATION_MODEL=deepseek-v4-flash

# Hardware Acceleration (cpu or cuda)
OCR_GPU=cpu
BUBBLE_DEVICE=cpu
CTD_DEVICE=auto

# Optional Core Features
LAMA_ENABLED=true
CTD_ENABLED=true

# Experimental / Fine-Tuning Features (Disabled by default)
# JAVI_ANALYSIS_ENABLED=false
# VISUAL_SUPERVISOR_ENABLED=false
