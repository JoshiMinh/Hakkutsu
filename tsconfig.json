{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "~assets": ["./public/assets"],
      "~assets/*": ["./public/assets/*"],
      "~/assets": ["./public/assets"],
      "~/assets/*": ["./public/assets/*"],
      "~components": ["./src/components"],
      "~components/*": ["./src/components/*"],
      "~lib": ["./src/lib"],
      "~lib/*": ["./src/lib/*"],
      "~contents": ["./src/contents"],
      "~contents/*": ["./src/contents/*"],
      "~style.css": ["./src/style.css"],
      "~": ["./src"],
      "~/*": ["./src/*"]
    }
  }
}
