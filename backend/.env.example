# Hakkutsu Backend Environment Variables
# Copy this to .env and fill in your values

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS origins (comma-separated)
# CORS_ORIGINS=["http://localhost:3000"]

# Firebase (optional)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CREDENTIALS_PATH=path/to/credentials.json

# Data paths
JMDICT_PATH=app/data/jmdict/jmdict-eng.json
JLPT_DATA_PATH=app/data/jlpt
FREQUENCY_DATA_PATH=app/data/frequency

# Sudachi mode: A=short, B=medium, C=long
SUDACHI_MODE=C
